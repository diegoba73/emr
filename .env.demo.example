# SYNESIS EMR — variables del stack DEMO aislado
# Copiar a .env.demo (no commitear secretos reales).
# Uso: docker compose -p emr-demo -f docker-compose.demo.yml --env-file .env.demo up -d --build

# Puerto publicado en el host (local y prod demo)
DEMO_HTTP_PORT=8081

# Django (HTTP plano en demo; sin SSL redirect)
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=demo-local-secret-change-me-not-for-prod
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_USE_PROXY_SSL_HEADER=False

# Postgres del stack demo (volumen distinto = BD distinta del clínico).
# POSTGRES_* = admin del contenedor (migrate / seed / grants).
# DB_USER/DB_PASSWORD = runtime Django read-only (SELECT + sesión login).
DB_NAME=synesis_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=demo_postgres_change_me
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=demo_postgres_change_me
DB_USER=demo_readonly
DB_PASSWORD=demo_readonly_change_me

RUN_MIGRATIONS=true
RUN_SEED=false
GUNICORN_WORKERS=2

# --- Producción demo (servidor, puerto público 8081) — descomentar y ajustar ---
# DJANGO_DEBUG=False
# DJANGO_SECRET_KEY=<generar secreto fuerte>
# DJANGO_ALLOWED_HOSTS=emr.sytes.net,localhost
# DJANGO_CORS_ALLOWED_ORIGINS=http://emr.sytes.net:8081
# DJANGO_CSRF_TRUSTED_ORIGINS=http://emr.sytes.net:8081
