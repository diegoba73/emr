# SYNESIS EMR — variables del stack DEMO aislado
# Copiar a .env.demo (no commitear secretos reales).
# Uso: docker compose -p emr-demo -f docker-compose.demo.yml --env-file .env.demo up -d --build

# Puerto publicado en el host (local y prod demo)
DEMO_HTTP_PORT=8081

# Django (HTTP plano en demo; sin SSL redirect)
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=demo-local-secret-change-me-not-for-prod
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_USE_PROXY_SSL_HEADER=False

# Postgres interno del stack demo (mismo nombre lógico synesis_db; volumen distinto = BD distinta)
# NO es el contenedor emr_postgres del desarrollo habitual.
DB_NAME=synesis_db
DB_USER=postgres
DB_PASSWORD=demo_postgres_change_me

RUN_MIGRATIONS=true
RUN_SEED=false
GUNICORN_WORKERS=2

# --- Producción demo (servidor, puerto público 8081) — descomentar y ajustar ---
# DJANGO_DEBUG=False
# DJANGO_SECRET_KEY=<generar secreto fuerte>
# DJANGO_ALLOWED_HOSTS=dsachubut.sytes.net,localhost
# DJANGO_CORS_ALLOWED_ORIGINS=http://dsachubut.sytes.net:8081
# DJANGO_CSRF_TRUSTED_ORIGINS=http://dsachubut.sytes.net:8081
