{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_CLINICS_JSON": "[{\"code\":\"ICPL\",\"name\":\"Instituto de Cardiología Pueblo de Luis\",\"apiUrl\":\"https://emr.sytes.net:8080/api/movil\"}]",
        "EXPO_PUBLIC_ALLOW_LOCAL_HTTP": "false",
        "EXPO_PUBLIC_API_URL": "https://emr.sytes.net:8080/api/movil"
      },
      "developmentClient": false,
      "android": {
        "buildType": "apk"
      },
      "environment": "preview"
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_CLINICS_JSON": "[{\"code\":\"ICPL\",\"name\":\"Instituto de Cardiología Pueblo de Luis\",\"apiUrl\":\"https://emr.sytes.net:8080/api/movil\"}]",
        "EXPO_PUBLIC_ALLOW_LOCAL_HTTP": "false",
        "EXPO_PUBLIC_API_URL": "https://emr.sytes.net:8080/api/movil"
      },
      "environment": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
