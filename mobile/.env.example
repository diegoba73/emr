# URL del backend con certificado HTTPS válido. Sin barra final.
EXPO_PUBLIC_API_URL=https://emr.sytes.net:8080/api/movil
# Asignado al crear el proyecto EAS de la institución.
EXPO_PUBLIC_EAS_PROJECT_ID=
# Identificadores definitivos antes del primer envío a las tiendas.
SYNESIS_IOS_BUNDLE_ID=net.sytes.emr.synesismovil
SYNESIS_ANDROID_PACKAGE=net.sytes.emr.synesismovil
# Archivo de configuración FCM de Android (fuera de Git).
GOOGLE_SERVICES_JSON=
# Catálogo autorizado para producción; en desarrollo se habilita ICPL local si no se define.
EXPO_PUBLIC_CLINICS_JSON=
