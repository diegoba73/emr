# SYNESIS EMR/LIMS — variables de entorno (desarrollo local)
# Copiar a .env y ajustar. No commitear secretos reales.

# --- Django core ---
DJANGO_DEBUG=True
DJANGO_RUNTIME=runserver
# Solo desarrollo local; en producción usar get_random_secret_key() o gestor de secretos.
DJANGO_SECRET_KEY=change-me-local-only
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# --- Kiosco / QR (CEHTA e ICPL = mismo EMR público) ---
# En producción el QR usa PUBLIC_API_BASE_URL (más abajo), p. ej.:
#   https://emr.icpueblodeluis.com.ar:8080/kiosco-recepcion
# Override opcional del origen del QR (si difiere del API):
# EMR_KIOSCO_PUBLIC_ORIGIN=https://emr.icpueblodeluis.com.ar:8080
#
# --- Solo desarrollo local (Wi‑Fi de la PC; no usar en el cartel de CEHTA) ---
# EMR_LAN_IPS=192.168.1.25,10.0.0.5
# EMR_KIOSCO_LAN_ORIGIN=http://192.168.1.25:3000
# EMR_KIOSCO_LAN_ORIGINS=http://192.168.1.25:3000,http://10.0.0.5:3000
# EMR_KIOSCO_FRONTEND_PORT=3000
# EMR_API_PORT=8000
# EMR_DEV_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend,192.168.1.25

# --- CORS / CSRF (desarrollo) ---
# En DEBUG=True, CORS puede estar abierto; opcionalmente restringir orígenes:
# DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
# DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# --- HTTPS / cookies (desarrollo HTTP) ---
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
# DJANGO_USE_PROXY_SSL_HEADER=False

# --- Base de datos (desarrollo híbrido: Postgres en Docker emr_postgres) ---
# Una sola BD local: contenedor emr_postgres → localhost:5432
# Levantar con: ./emrctl up
# NO usar synesis_user ni Postgres nativo en WSL (genera bases duplicadas).
DB_ENGINE=django.db.backends.postgresql
DB_NAME=synesis_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# --- Correo (informes LIMS) ---
# Por defecto (sin SMTP) los mails solo se imprimen en la consola del backend.
#
# Destino ICPL (dominio institucional; MX → mail.icpueblodeluis.com.ar).
# Pedir contraseña SMTP al admin del hosting (cPanel / ServidoraWeb) antes de activar.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=mail.icpueblodeluis.com.ar
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=laboratorio@icpueblodeluis.com.ar
# EMAIL_HOST_PASSWORD=REEMPLAZAR
# DEFAULT_FROM_EMAIL="Laboratorio Pueblo de Luis <laboratorio@icpueblodeluis.com.ar>"
# EMAIL_TIMEOUT=15
#
# Referencia Gmail (alternativa / pruebas): 2FA + contraseña de aplicación
# https://myaccount.google.com/apppasswords
# EMAIL_HOST=smtp.gmail.com
# EMAIL_HOST_USER=tu-cuenta@gmail.com
# EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx
# DEFAULT_FROM_EMAIL=tu-cuenta@gmail.com

# URL pública del EMR (WhatsApp/PDF y QR de recepción CEHTA/ICPL).
# En local se puede omitir. En producción:
# PUBLIC_API_BASE_URL=https://emr.icpueblodeluis.com.ar:8080

# --- MedGemma / Ollama (sugerencias locales; opcional) ---
# Solo desarrollo local. En producción: MEDGEMMA_ENABLED=false (sin Ollama).
# Ver docs/medgemma-ollama.md
# MEDGEMMA_ENABLED=false
# MEDGEMMA_BASE_URL=http://host.docker.internal:11434
# MEDGEMMA_MODEL=medgemma:4b
# MEDGEMMA_TIMEOUT_SECONDS=90

# --- Impresora de etiquetas LIMS (3nStar LDT114 USB en la PC del operador) ---
# El botón Imprimir usa un agente local (scripts/label_print_agent.ps1) en 127.0.0.1:18181.
# HOST/PORT del servidor ya no se usan para ese flujo; se pueden dejar comentados.
# LIMS_LABEL_PRINTER_ENABLED=false
# LIMS_LABEL_PRINTER_HOST=
# LIMS_LABEL_PRINTER_PORT=9100
# LIMS_LABEL_PRINTER_TIMEOUT_SECONDS=5
# LIMS_LABEL_PRINTER_PROFILE=3nstar_ldt114_203_40x23

# --- Interfaz analizadores LIMS (CM260 / Sysmex XP-300, ASTM) ---
# Gateway TCP/serial fuera de gunicorn. Token para POST /api/lab/instrumentos/*.
# LIMS_INSTRUMENT_ENABLED=false
# LIMS_INSTRUMENT_TOKEN=
# LIMS_INSTRUMENT_LISTEN_HOST=0.0.0.0
# LIMS_INSTRUMENT_LISTEN_PORT=5000
