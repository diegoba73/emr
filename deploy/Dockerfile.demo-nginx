# Imagen Nginx del stack DEMO: build React (same-origin /api) + conf nginx.demo.
# Contexto de build: raíz del repo EMR.

FROM node:20-alpine AS frontend_build
WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --legacy-peer-deps
COPY frontend/ ./
# Misma origin vía nginx clínico: /showcase + /showcase-api (no usa el puerto 8081 público).
ARG PUBLIC_URL=/showcase
ARG REACT_APP_API_URL=/showcase-api
ENV PUBLIC_URL=$PUBLIC_URL
ENV REACT_APP_API_URL=$REACT_APP_API_URL
ENV REACT_APP_CSRF_COOKIE_NAME=emr_demo_csrftoken
ENV REACT_APP_DEMO_MODE=true
ENV CI=false
ENV DISABLE_ESLINT_PLUGIN=true
RUN npm run build && node scripts/prepare-demo-branding.cjs

FROM nginx:1.27-alpine
COPY deploy/nginx/nginx.demo.conf /etc/nginx/conf.d/default.conf
COPY --from=frontend_build /frontend/build /usr/share/nginx/html
EXPOSE 80
